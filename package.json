{
  "name": "@micropasts/iiif-viewer",
  "version": "1.0.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Standalone IIIF Presentation 2.0, 3.0 & 4.0 manifest, deep-zoom, 3D scene, and annotation viewer",
  "license": "MPL-2.0",
  "author": {
    "name": "Daniel Pett",
    "email": "info@micropasts.org",
    "url": "https://github.com/micropasts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micropasts/iiif-viewer.git"
  },
  "homepage": "https://micropasts.github.io/iiif-viewer/",
  "bugs": {
    "url": "https://github.com/micropasts/iiif-viewer/issues"
  },
  "type": "module",
  "main": "./dist/iiif-viewer.umd.cjs",
  "module": "./dist/iiif-viewer.js",
  "exports": {
    ".": {
      "import": "./dist/iiif-viewer.js",
      "require": "./dist/iiif-viewer.umd.cjs"
    },
    "./style.css": "./dist/iiif-viewer.css"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:docs": "vite build --mode docs"
  },
  "dependencies": {
    "openseadragon": "^5.0.1",
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "vite": "^6.2.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
